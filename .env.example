# WAFpass MCP bridge configuration
# Copy to .env and adjust for your environment.

# Upstream WAF++ backend.
WAFPASS_API_BASE_URL=http://localhost:8000

# How the MCP bridge validates Bearer tokens.
# Options:
#   "introspection" -> call GET /auth/me on WAFpass (default, safest, IdP-agnostic)
#   "jwt_secret"    -> locally verify HS256 tokens using WAFPASS_JWT_SECRET
WAFPASS_TOKEN_MODE=introspection

# Required when WAFPASS_TOKEN_MODE=jwt_secret. Must match the backend secret.
WAFPASS_JWT_SECRET=change-me-in-production-wafpass-secret-key

# MCP bridge listen address.
MCP_HOST=0.0.0.0
MCP_PORT=3001

# Logging.
LOG_LEVEL=INFO
